{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "apps/web-ele/dist",
        "buildCommand": "npx pnpm@10.28.2 install && npx pnpm@10.28.2 run build:ele"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/web-ele/dist/$1"
    }
  ]
}
